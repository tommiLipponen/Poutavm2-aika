[Unit]
Description=PostgreSQL Backup Service for TimeApp
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=timeapp
Group=timeapp

# Backup script
ExecStart=/opt/timeapp/infra/backup_pg.sh

# Logging
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
