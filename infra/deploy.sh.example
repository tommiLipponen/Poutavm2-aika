#!/bin/bash
# Deployment script for TimeApp
# Usage: ./deploy.sh

set -e  # Exit on error

# Configuration
APP_NAME="timeapp"
APP_USER="timeapp"
APP_DIR="/opt/timeapp"
REPO_URL="https://github.com/tommiLipponen/Poutavm2-aika.git"
BRANCH="master"
VENV_DIR="$APP_DIR/venv"

echo "========================================="
echo "TimeApp Deployment Script"
echo "========================================="

# Check if running as root
if [ "$EUID" -ne 0 ]; then 
    echo "Please run as root (use sudo)"
    exit 1
fi

# Create application user if doesn't exist
if ! id "$APP_USER" &>/dev/null; then
    echo "Creating user $APP_USER..."
    useradd -r -s /bin/bash -d "$APP_DIR" -m "$APP_USER"
fi

# Install system dependencies
echo "Installing system dependencies..."
apt-get update
apt-get install -y python3 python3-pip python3-venv postgresql postgresql-contrib nginx git

# Create application directory
echo "Setting up application directory..."
mkdir -p "$APP_DIR"
mkdir -p /var/log/timeapp

# Clone or update repository
if [ -d "$APP_DIR/.git" ]; then
    echo "Updating repository..."
    cd "$APP_DIR"
    chown -R "$APP_USER:$APP_USER" "$APP_DIR"
    sudo -u "$APP_USER" git fetch origin
    sudo -u "$APP_USER" git reset --hard origin/"$BRANCH"
else
    echo "Cloning repository..."
    if [ -d "$APP_DIR" ] && [ "$(ls -A $APP_DIR)" ]; then
        echo "Directory $APP_DIR exists and is not empty. Removing contents..."
        rm -rf "$APP_DIR"
    fi
    mkdir -p "$APP_DIR"
    chown -R "$APP_USER:$APP_USER" "$APP_DIR"
    sudo -u "$APP_USER" git clone -b "$BRANCH" "$REPO_URL" "$APP_DIR"
    cd "$APP_DIR"
fi

# Create virtual environment
if [ ! -d "$VENV_DIR" ]; then
    echo "Creating virtual environment..."
    sudo -u "$APP_USER" python3 -m venv "$VENV_DIR"
fi

# Install Python dependencies
echo "Installing Python dependencies..."
sudo -u "$APP_USER" "$VENV_DIR/bin/pip" install --upgrade pip
sudo -u "$APP_USER" "$VENV_DIR/bin/pip" install -r requirements.txt

# Setup PostgreSQL database
echo "Setting up PostgreSQL database..."
sudo -u postgres psql -c "CREATE USER $APP_USER WITH PASSWORD 'change-this-password';" 2>/dev/null || true
sudo -u postgres psql -c "CREATE DATABASE $APP_NAME OWNER $APP_USER;" 2>/dev/null || true
sudo -u postgres psql -c "GRANT ALL PRIVILEGES ON DATABASE $APP_NAME TO $APP_USER;" 2>/dev/null || true

# Copy configuration files
echo "Installing systemd service..."
cp infra/timeapp.service.example /etc/systemd/system/timeapp.service
# Remember to edit /etc/systemd/system/timeapp.service with correct settings

echo "Installing nginx configuration..."
cp infra/nginx.timeapp.conf.example /etc/nginx/sites-available/timeapp
ln -sf /etc/nginx/sites-available/timeapp /etc/nginx/sites-enabled/timeapp
# Remember to edit /etc/nginx/sites-available/timeapp with your domain

# Set permissions
echo "Setting permissions..."
chown -R "$APP_USER:$APP_USER" "$APP_DIR"
chown -R "$APP_USER:$APP_USER" /var/log/timeapp
chmod 750 "$APP_DIR"

# Reload systemd and start services
echo "Starting services..."
systemctl daemon-reload
systemctl enable timeapp
systemctl restart timeapp
nginx -t && systemctl restart nginx

# Setup firewall
echo "Configuring firewall..."
ufw allow 'Nginx Full'
ufw allow OpenSSH
ufw --force enable

echo "========================================="
echo "Deployment completed!"
echo "========================================="
echo "Next steps:"
echo "1. Edit /etc/systemd/system/timeapp.service with your SECRET_KEY and DATABASE_URL"
echo "2. Edit /etc/nginx/sites-available/timeapp with your domain name"
echo "3. Setup SSL with: sudo certbot --nginx -d your-domain.com"
echo "4. Check status: systemctl status timeapp"
echo "5. View logs: journalctl -u timeapp -f"
echo "========================================="
